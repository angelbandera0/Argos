# Supabase project URL. Public. Filled by the developer (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Public, safe for the browser. Filled by the developer.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role key. SECRET: server only, bypasses RLS. Copied by the human from the dashboard (Project Settings -> API); never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side pepper mixed into PIN hashes. SECRET: random, 32+ characters (openssl rand -hex 32). Generated once per environment; changing it invalidates all PINs.
PIN_PEPPER=

# Email of the initial superadmin account. Not secret. Filled by the human before running the seed.
SUPERADMIN_EMAIL=

# Initial superadmin password. SECRET: filled by the human, only used by the seed; change it after first login.
SUPERADMIN_INITIAL_PASSWORD=
